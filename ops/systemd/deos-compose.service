[Unit]
Description=DEOS Docker Compose Stack
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f ops/compose/docker-compose.autostart.yml up --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.yml down
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
